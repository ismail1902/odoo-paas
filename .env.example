# Odoo PaaS configuration. Copy to .env and adjust. install.sh generates this
# automatically on the server with a random SECRET_KEY and PG_PASSWORD.

# --- Core ---
APP_NAME=Odoo PaaS
SECRET_KEY=change-me-to-a-long-random-string
DATA_DIR=var
# Bind address/port of the control plane UI
HOST=0.0.0.0
PORT=8000
# Optional: hostname or IP used to build build URLs shown in the UI
# (e.g. 203.0.113.10). Leave empty to use the request's Host header.
PUBLIC_HOST=

# --- First admin (created on first start if users table is empty) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Build port pool (each branch/build gets one host port) ---
PORT_RANGE_START=9000
PORT_RANGE_END=9990

# --- Reverse proxy / HTTPS ---
# Loopback-only gevent/websocket ports for branches with a custom domain
GEVENT_PORT_RANGE_START=10000
GEVENT_PORT_RANGE_END=10990
# Email used by Let's Encrypt (leave empty to register without expiry notices)
ACME_EMAIL=

# --- Docker ---
DOCKER_NETWORK=odoo-paas
# PG16 keeps the historical name; PG15 gets its own shared container.
PG_CONTAINER=odoo-paas-pg
PG_CONTAINER_15=odoo-paas-pg15
PG_USER=odoo
PG_PASSWORD=change-me-too
MAILPIT_CONTAINER=odoo-paas-mailpit
MAILPIT_PORT=8025
BASE_IMAGE=odoo-paas/base:17.0
ODOO_VERSION=17.0
# Optional wkhtmltopdf .deb URL for base images (needed on arm64 for PDF reports)
WKHTMLTOPDF_DEB=
# Versions listed when no base images are built yet / in MOCK_DOCKER mode
ODOO_VERSIONS=15.0,16.0,17.0,18.0,19.0,20.0
# MOCK_DOCKER=true simulates Docker ops (used for local UI development on macOS)
MOCK_DOCKER=false
WORKER_ENABLED=true
